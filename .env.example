# Plantilla de variables de entorno. Copia este archivo a ".env" y rellena los
# valores. (El .env real está en .gitignore y no se sube al repositorio.)

# --- Supabase ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# --- Google Gemini ---
# Key para analizar documentos con la API de Gemini (modelo gemini-2.0-flash).
# ⚠️ Al no haber backend, esta key se incrusta en el bundle del navegador.
# Úsala solo en esta herramienta interna; en producción muévela a un backend.
VITE_GEMINI_API_KEY=tu-gemini-api-key
# Opcional: modelo de Gemini a usar (por defecto gemini-2.0-flash).
# VITE_GEMINI_MODEL=gemini-2.5-flash
